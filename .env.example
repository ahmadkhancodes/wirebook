# Copy to .env.local for dev. Never commit real values. Missing keys = stub mode.
APP_NAME=wirebook
NEXT_PUBLIC_APP_URL=http://localhost:3000
# memory | mongo (defaults to mongo when MONGODB_URI is set)
DB_DRIVER=memory
MONGODB_URI=
MONGODB_DB=wirebook
# >= 32 random chars, unique per app: openssl rand -base64 32
BETTER_AUTH_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# console | resend | smtp
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=
CRON_SECRET=
ALTCHA_HMAC_KEY=
# JSON of remote flags, e.g. {"payments_enabled":"on"}
APP_FLAGS=
# comma separated founder admin emails
ADMIN_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# /v1 sync wait in ms before answering 202 (55000 fits Vercel Hobby; 90000 on Pro)
SYNC_WAIT_MS=
# how long /qbwc may hold sendRequestXML open waiting for a job (0 = off until measured on a real Web Connector)
QBWC_HOLD_MS=
